
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Parallel Test Suite"
       parallel="classes"
       thread-count="8">

    <test name="Parallel Tests">
        <classes>
            <class name="ParrellTestCases.CorrectUserName"/>
            <class name="ParrellTestCases.IncorrectUserName"/>
            <class name="ParrellTestCases.Login"/>
            <class name="ParrellTestCases.LoginBlank"/>
            <class name="ParrellTestCases.LoginNegative"/>
            <class name="ParrellTestCases.RegisterBlank"/>
            <class name="ParrellTestCases.RegisterNegative"/>
            <class name="ParrellTestCases.RegisterPositive"/>
        </classes>
    </test>

</suite>